{
  "name": "task1-metering",
  "version": "1.0.0",
  "private": true,
  "description": "AI usage metering & quota system (home assignment, Task 1)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prestart": "npm install --no-audit --no-fund --loglevel=error",
    "start": "tsx src/server.ts",
